{
  "name": "Omarchy (Arch Linux)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "codespace",
  "containerEnv": {
    "LANG": "en_US.UTF-8"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      }
    }
  },
  "postCreateCommand": "sudo pacman -Syu --noconfirm"
}
