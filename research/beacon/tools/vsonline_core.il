ed\" ]; then\n            bytes=$((bytes - size))\n        fi\n    done < <(find \"$directory\" -xdev -type f -printf '%T@ %s %p\\0' 2>/dev/null | sort -z -n)\nfi\nmeasure\nresult=completed\nif [ \"$delete_failures\" -gt 0 ]; then\n    result=completed_with_delete_failures\nelif [ \"$bytes\" -gt \"$max_bytes\" ] && [ \"$open_skipped\" -gt 0 ]; then\n    result=completed_open_files_exceed_cap\nelif [ \"$bytes\" -gt \"$max_bytes\" ]; then\n    result=cap_not_met\nfi\nprintf 'Result=%s\\nBytesBefore=%s\\nBytesAfter=%s\\nFilesBefore=%s\\nFilesAfter=%s\\nDeletedFiles=%s\\nDeletedBytes=%s\\nOpenFilesSkipped=%s\\nDeleteFailures=%s\\n' \\\n    \"$result\" \"$bytes_before\" \"$bytes\" \"$files_before\" \"$files\" \"$deleted_files\" \"$deleted_bytes\" \"$open_skipped\" \"$delete_failures\""
